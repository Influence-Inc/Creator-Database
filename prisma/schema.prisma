// ---------------------------------------------------------------------------
// Creator Database — Prisma schema
//
// One master `Creator` record per real-world creator. Outreach syncs and
// Claude email extractions both funnel into that record instead of creating
// duplicates (see CreatorsService.upsertFromSource for the merge logic).
//
// Supporting tables:
//   Campaign      one row per Instantly campaign
//   EmailHistory  every fetched email message + its Claude extraction
//   ActivityLog   append-only audit of every field change
//   FailedJob     dead-letter queue for failed sync / extraction jobs
//   SyncRun       observability record for each background/manual sync run
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Negotiation lifecycle for a creator deal.
enum NegotiationStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  COMPLETED
}

/// Where a change originated. Recorded on every ActivityLog entry.
enum ActivitySource {
  INSTANTLY_DASHBOARD
  CLAUDE_EXTRACTION
  EMAIL_SYNC
  MANUAL_API
  SYSTEM
  CONTRACT_SIGNED
  STATS_SYNC
  SCOUT_PROMOTION
}

/// Lifecycle of a signed creator contract.
enum ContractStatus {
  PENDING
  SIGNED
  COMPLETED
}

/// Kind of background job — used by SyncRun and FailedJob.
enum JobType {
  OUTREACH_SYNC
  EMAIL_SYNC
  CLAUDE_EXTRACTION
  STATS_SYNC
}

/// Outcome of a sync run.
enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Creator {
  id String @id @default(uuid())

  // --- Identity (dedup keys, in priority order: email > instagram > name) ---
  creatorName          String?
  instagramUsername    String? @unique
  instagramProfileLink String?
  email                String? @unique
  phoneNumber          String?

  // --- Mailing address (Contact & identity in the dashboard) ---------------
  // Nullable on purpose — a creator can be tracked before we've collected an
  // address. When a signed contract exists, the same address is mirrored to
  // Contract.addressLine1… so payments still read from the payment-of-record
  // (see roster.service.updateDetails).
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  /// Payout/bank details captured on the creator's Payment account card in the
  /// admin UI (account holder, bank name, account number, IBAN, routing, IFSC,
  /// PAN, SWIFT, tax id). Stored as JSON so the shape can vary by country. This
  /// is the source of truth for a creator's payout details — held on the master
  /// Creator record so payout information can be captured BEFORE a contract is
  /// signed. When a signed contract exists, `updateDetails` also mirrors these
  /// values onto the latest `Contract.paymentDetails` so per-contract
  /// payment-of-record documents stay in sync. Sensitive — protected by the same
  /// x-api-key guard as every other write, and only ever read back through the
  /// authenticated contract endpoints.
  paymentDetails Json?

  // --- Campaign info -------------------------------------------------------
  campaignName    String?
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  outreachStage   String?
  assignedManager String?

  // --- Performance ---------------------------------------------------------
  averageViews   Int?
  averageLikes   Int?
  engagementRate Float?
  followers      Int?
  /// Risk tier synced from ReelMetrics / influence-stats (e.g. "Low"/"Medium"/"High").
  riskLevel      String?

  // --- Commercial ----------------------------------------------------------
  cpm          Float?
  acceptedRate Float?
  quotedRate   Float?
  currency     String? @default("USD")

  // --- Campaign deliverables ----------------------------------------------
  numberOfVideos          Int?
  numberOfStories         Int?
  numberOfReels           Int?
  guaranteedViews         Int?
  deadline                DateTime?
  deliverablesDescription String?

  // --- Communication -------------------------------------------------------
  latestEmailDate DateTime?
  lastReplyDate   DateTime?
  threadId        String?
  emailStatus     String?

  // --- Deliverability ------------------------------------------------------
  inboxRate Float?
  spamRate  Float?
  bounced   Boolean @default(false)
  opened    Boolean @default(false)
  replied   Boolean @default(false)

  // --- Negotiation status --------------------------------------------------
  status NegotiationStatus @default(PENDING)

  // --- Metadata ------------------------------------------------------------
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailHistory EmailHistory[]
  activityLogs ActivityLog[]
  contracts    Contract[]
  stats        CreatorStats[]
  scoutEntries ScoutEntry[]

  @@index([creatorName])
  @@index([campaignId])
  @@index([assignedManager])
  @@index([status])
  @@index([deadline])
  @@index([updatedAt])
  @@map("creators")
}

model Campaign {
  id String @id @default(uuid())

  /// Human-readable campaign name (unique so outreach sync can upsert by name).
  name                String  @unique
  /// Upstream Instantly campaign UUID, when known.
  instantlyCampaignId String? @unique
  brandName           String?
  /// Full upstream payload stashed for reference / future fields.
  data                Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  creators Creator[]

  @@index([instantlyCampaignId])
  @@map("campaigns")
}

/// One row per signed creator contract, synced from the Outreach backend after a
/// creator signs. Preserves per-contract terms (a creator's single-valued
/// commercial fields get overwritten each campaign; this is the durable history).
model Contract {
  id String @id @default(uuid())

  /// The Outreach backend's contract token — stable, unique, dedups re-syncs.
  contractRef String  @unique
  contractUrl String?

  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // --- Campaign + deliverables --------------------------------------------
  brandName            String?
  campaignName         String?
  platform             String?
  deliverables         String?
  numberOfDeliverables Int?
  timeline             String?
  deadline             DateTime?
  usageRights          String?
  exclusivity          String?
  guaranteedViews      Int?

  // --- Commercial ----------------------------------------------------------
  compensation Float?
  currency     String? @default("USD")
  paymentTerms String?

  // --- Extra terms ---------------------------------------------------------
  specialNotes    String?
  additionalTerms Json?

  // --- Signature + signer details -----------------------------------------
  status           ContractStatus @default(PENDING)
  signerName       String?
  signerEmail      String?
  signerPhone      String?
  signerGender     String?
  /// The date the signer entered on the form (distinct from `signedAt`, the
  /// server timestamp the submission was recorded).
  signerSignedDate DateTime?
  /// Drawn-signature image as a base64 data URL (data:image/png;base64,…).
  signatureImage   String?        @db.Text
  signedAt         DateTime?

  // --- Signer mailing address ---------------------------------------------
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  /// Payout/bank details captured on the signing form (account holder, bank
  /// name, account number, IBAN, routing, IFSC, PAN, SWIFT, tax id). Stored as
  /// JSON so the shape can vary by country. Sensitive — protected by the same
  /// x-api-key guard as every other write, and only ever read back through the
  /// authenticated contract endpoints.
  paymentDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@map("contracts")
}

/// Per-campaign performance snapshot synced from ReelMetrics / influence-stats
/// (`GET /api/bot/campaigns`). One row per creator per stats campaign, so a
/// creator who runs several campaigns keeps a durable per-campaign history of
/// views, engagement, CPM and risk — the same pattern as Contract, which keeps
/// per-contract commercial history. Re-syncs upsert on (creatorId, statsCampaignId).
model CreatorStats {
  id String @id @default(uuid())

  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  /// The influence-stats campaign id this snapshot came from.
  statsCampaignId String
  campaignName    String?
  brandName       String?
  /// Platforms the creator posted on for this campaign, e.g. "IG, TT".
  platforms       String?

  // --- Combined performance (across all of this campaign's posts) ----------
  totalViews    Int?
  totalLikes    Int?
  totalComments Int?
  postCount     Int?
  videosPosted  Int?

  // --- Commercial + risk ---------------------------------------------------
  riskLevel    String?
  bookedCpm    Float?
  realizedCpm  Float?
  budget       Float?
  grossPay     Float?
  creatorAsk   Float?
  currency     String? @default("USD")
  paidAdRights String?

  // --- Deliverables --------------------------------------------------------
  minViews             Int?
  minVideos            Int?
  deliverablesComplete Boolean?
  deadline             DateTime?

  /// Per-post detail: [{ id, title, uploadDate, links, viewsByPlatform,
  /// totalViews, likes, comments }, …]. The per-post "views in each of their
  /// posts" alongside the combined totals above.
  videos Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, statsCampaignId])
  @@index([creatorId])
  @@index([statsCampaignId])
  @@index([riskLevel])
  @@map("creator_stats")
}

model EmailHistory {
  id String @id @default(uuid())

  threadId  String
  messageId String    @unique
  sender    String?
  recipient String?
  subject   String?
  timestamp DateTime?

  /// Raw email body (text or html) as fetched from Instantly.
  rawEmail    String? @db.Text
  /// Hash of the message content — lets us detect edited threads cheaply.
  contentHash String?

  /// Structured JSON returned by Claude for the thread this message belongs to.
  claudeJson  Json?
  /// When Claude last processed the thread this message belongs to (null = pending).
  processedAt DateTime?

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([creatorId])
  @@index([processedAt])
  @@map("email_history")
}

model ActivityLog {
  id String @id @default(uuid())

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  changedField String
  oldValue     String?
  newValue     String?
  source       ActivitySource

  createdAt DateTime @default(now())

  @@index([creatorId])
  @@index([source])
  @@index([createdAt])
  @@map("activity_logs")
}

model FailedJob {
  id String @id @default(uuid())

  jobType  JobType
  /// Arbitrary payload needed to retry the job (e.g. { threadId } or a lead).
  payload  Json
  error    String  @db.Text
  attempts Int     @default(1)
  resolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobType])
  @@index([resolved])
  @@map("failed_jobs")
}

model SyncRun {
  id String @id @default(uuid())

  jobType        JobType
  status         SyncStatus @default(RUNNING)
  itemsProcessed Int        @default(0)
  itemsCreated   Int        @default(0)
  itemsUpdated   Int        @default(0)
  itemsFailed    Int        @default(0)
  error          String?    @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([jobType])
  @@index([status])
  @@index([startedAt])
  @@map("sync_runs")
}

/// Who a `User` is and what they may reach.
///   ADMIN  full Creator Database console (and every scout sheet)
///   SCOUT  only their own scouting sheet
enum UserRole {
  ADMIN
  SCOUT
}

/// Self-reported gender of a scouted creator.
enum ScoutGender {
  MALE
  FEMALE
  OTHER
}

/// Admin verdict on a scouted creator. Scouts see it but cannot set it.
enum QualificationStatus {
  PENDING
  QUALIFIED
  REJECTED
}

/// A person who can sign in. Admins manage the Creator Database console;
/// scouts get a personal scouting sheet and can only ever see their own rows.
///
/// Passwords are stored as scrypt hashes (`scrypt$N$r$p$salt$hash`) — never in
/// plain text. The bootstrap admin from ADMIN_USERNAME/ADMIN_PASSWORD still
/// works without a row here, so existing deployments keep signing in unchanged.
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(SCOUT)
  /// Deactivated users keep their rows but can no longer sign in.
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Instagram handle this scout sends finds from, set by an admin. Inbound DMs
  /// to the company account are matched to a scout by this, so a scout with no
  /// handle set simply never receives anything from Instagram.
  instagramHandle String? @unique
  /// Instagram-scoped user id (IGSID) for the same person. Meta identifies a
  /// sender by this opaque id rather than by username, so it's cached the first
  /// time a message is matched and used directly afterwards.
  instagramUserId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoutEntries      ScoutEntry[]       @relation("ScoutEntryOwner")
  reviewedEntries   ScoutEntry[]       @relation("ScoutEntryReviewer")
  instagramMessages InstagramMessage[]

  @@index([role])
  @@index([isActive])
  @@index([instagramUserId])
  @@map("users")
}

/// One row on a scout's sheet: a creator they found manually online.
///
/// `rowNumber` is the visible "numbering" column and is sequential *per scout*,
/// so each sheet reads 1..n independently. Everything from `instagramProfileLink`
/// through `language` is scout-editable; `qualification` and `notes` are the
/// admin's verdict and are read-only to the scout. When an admin qualifies a
/// row it can be promoted into the Creator Database, and `promotedCreatorId`
/// links to the resulting master record.
model ScoutEntry {
  id String @id @default(uuid())

  /// Owning scout. Rows are only ever visible to this user (and admins).
  scoutId String
  scout   User   @relation("ScoutEntryOwner", fields: [scoutId], references: [id], onDelete: Cascade)

  /// Sequential per-scout row number shown as the "numbering" column.
  rowNumber Int

  // --- Scout-editable fields ----------------------------------------------
  instagramProfileLink String
  /// Handle parsed out of the profile link. Used for duplicate detection
  /// against other sheets and the Creator Database.
  instagramUsername    String?
  /// Reels this creator could replicate with the brand integrated.
  reelIdeas            String?
  approxAge            Int?
  gender               ScoutGender?
  /// Country name, when it can be determined.
  country              String?
  language             String?

  // --- Admin-only fields (read-only to the scout) -------------------------
  qualification QualificationStatus @default(PENDING)
  notes         String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?               @relation("ScoutEntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Set once the row has been promoted into the Creator Database.
  promotedCreatorId String?
  promotedCreator   Creator?  @relation(fields: [promotedCreatorId], references: [id], onDelete: SetNull)
  promotedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramMessages InstagramMessage[]

  @@unique([scoutId, rowNumber])
  @@index([scoutId])
  @@index([qualification])
  @@index([instagramUsername])
  @@index([createdAt])
  @@map("scout_entries")
}

/// What happened to an inbound Instagram DM.
enum InstagramMessageStatus {
  /// Matched to a scout and written onto one of their rows.
  APPLIED
  /// Contained no Instagram profile or reel link, so there was nothing to file.
  NO_LINKS
  /// Sender isn't linked to any scout — an admin needs to set that handle.
  UNMATCHED_SENDER
  /// Something went wrong while processing; `statusNote` says what.
  FAILED
}

/// Ledger of every direct message the company Instagram account receives.
///
/// This exists for three reasons: Meta redelivers webhooks, so `messageId` being
/// unique is what stops one share being filed twice; a message from someone we
/// can't place must stay visible instead of vanishing; and `raw` keeps the exact
/// payload, so if Meta's shape differs from what's expected the evidence is on
/// hand rather than lost.
model InstagramMessage {
  id String @id @default(uuid())

  /// Meta's own message id (`mid`). Unique — redelivery is a no-op.
  messageId      String  @unique
  /// Instagram-scoped id of the sender.
  senderId       String
  /// Resolved at ingest time when an access token is configured.
  senderUsername String?

  text         String?
  /// instagram.com profile links found in the message.
  profileLinks String[] @default([])
  /// Reel/post links found in the message.
  reelLinks    String[] @default([])
  /// Share attachments whose URL wasn't an instagram.com permalink (Meta
  /// sometimes sends a CDN media URL instead). Kept so nothing is discarded.
  otherLinks   String[] @default([])

  status     InstagramMessageStatus
  statusNote String?

  scoutId String?
  scout   User?   @relation(fields: [scoutId], references: [id], onDelete: SetNull)

  /// The sheet row this message created or filled in.
  entryId String?
  entry   ScoutEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  /// Verbatim webhook payload for this message.
  raw Json?

  receivedAt DateTime @default(now())

  @@index([status])
  @@index([senderId])
  @@index([scoutId])
  @@index([receivedAt])
  @@map("instagram_messages")
}

/// Every time Meta calls our webhook, however it ended.
///
/// The live diagnostic used to be held in memory, which made it useless for the
/// one question it existed to answer: a redeploy wiped it, so "Meta has never
/// called" and "Meta called before the last deploy" both read as null. Deliveries
/// rejected before the signature check leave no `InstagramMessage` row either, so
/// without this there is no durable evidence that Meta ever reached us at all.
model InstagramWebhookDelivery {
  id String @id @default(uuid())

  /// `accepted`, `rejected_bad_signature`, `rejected_no_signature`, …
  outcome String
  /// Human-readable specifics, e.g. which check failed.
  detail  String? @db.Text

  at DateTime @default(now())

  @@index([at])
  @@map("instagram_webhook_deliveries")
}
